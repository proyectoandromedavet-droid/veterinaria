# ═══════════════════════════════════════════════════════
#  VetManager Pro — Variables de entorno para PRODUCCIÓN
#  Copiar a .env y completar todos los valores
#  NUNCA commitear .env con valores reales
# ═══════════════════════════════════════════════════════

# ── Base de datos ──────────────────────────────────────
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=vetmanager
MYSQL_USER=vetmanager_app
MYSQL_PASSWORD=CHANGE_ME_strong_password_here
# MYSQL_PASSWORD_FILE=/run/secrets/db_password
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password_here

# ── Redis ──────────────────────────────────────────────
REDIS_URL=redis://shuttle.proxy.rlwy.net:41836
# Alternativa interna Railway:
# REDIS_URL=redis://redis.railway.internal:6379?family=0
REDIS_PASSWORD=CHANGE_ME_redis_password
# REDIS_PASSWORD_FILE=/run/secrets/redis_password
REDIS_HOST=
REDIS_PORT=
REDIS_USER=
DEPENDENCY_MODE_AUTH_REVOCATION=strict
DEPENDENCY_MODE_AUTH_SESSION_SECURITY=strict
AUTH_REVOCATION_SYNC_INTERVAL_MS=60000

# ── JWT (RS256) ────────────────────────────────────────
# Generar con: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nCHANGE_ME\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nCHANGE_ME\n-----END PUBLIC KEY-----"
# JWT_PRIVATE_KEY_FILE=/run/secrets/jwt_private_key.pem
# JWT_PUBLIC_KEY_FILE=/run/secrets/jwt_public_key.pem
# Opcional para rotacion coordinada entre servicios. Generar con: npm run secrets:jwt-rotate
# JWT_KEYRING_JSON=CHANGE_ME_base64_encoded_json
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
JWT_REVOCATION_TTL_SEC=900

# Documents / Email providers (bootstrap reference)
# Estas variables documentan la configuracion esperada para cuentas de correo.
# Hoy las credenciales efectivas se guardan por cuenta en mail_accounts.settings_json.
GOOGLE_REDIRECT_URI=https://api.vetmanager.io/documents/oauth/google/callback
DOCUMENTS_GMAIL_CLIENT_ID=CHANGE_ME
DOCUMENTS_GMAIL_CLIENT_SECRET=CHANGE_ME
DOCUMENTS_GMAIL_REFRESH_TOKEN=CHANGE_ME
DOCUMENTS_IMAP_HOST=imap.example.com
DOCUMENTS_IMAP_PORT=993
DOCUMENTS_IMAP_SECURE=true
DOCUMENTS_IMAP_USERNAME=documents@example.com
DOCUMENTS_IMAP_PASSWORD=CHANGE_ME
# Outlook / Microsoft Graph aun no esta implementado en documents.
DOCUMENTS_OUTLOOK_TENANT_ID=CHANGE_ME
DOCUMENTS_OUTLOOK_CLIENT_ID=CHANGE_ME
DOCUMENTS_OUTLOOK_CLIENT_SECRET=CHANGE_ME

# ── Seguridad interna (HMAC entre servicios) ───────────
INTERNAL_SECRET=CHANGE_ME_min_64_chars_random_string_here
# INTERNAL_SECRET_FILE=/run/secrets/internal_secret
INTERNAL_SIG_TTL_S=60

# ── App ────────────────────────────────────────────────
NODE_ENV=production
APP_VERSION=1.0.0
APP_DOMAIN=vetmanager.io
ALLOWED_HOSTS=app.vetmanager.io,portal.vetmanager.io
CORS_ORIGINS=https://app.vetmanager.io,https://portal.vetmanager.io
CSRF_SECRET=CHANGE_ME_min_64_chars_hex
FIELD_ENCRYPTION_SECRET=CHANGE_ME_min_32_chars_random_string_here
# FIELD_ENCRYPTION_SECRET_FILE=/run/secrets/field_encryption_secret
FIELD_ENCRYPTION_SALT=CHANGE_ME_unique_random_salt
# IMPORTANT: must NOT be the same value as JWT_PRIVATE_KEY or JWT_SECRET.
#            Changing the encryption secret or salt makes existing encrypted PII unreadable.
CSRF_EXCLUDE_PATHS=/api/v1/auth/login,/api/v1/auth/refresh,/api/v1/auth/password-reset/request,/api/v1/auth/password-reset/confirm,/api/v1/auth/2fa/challenge,/api/v2/auth/2fa/challenge,/api/v1/payments/mp/webhook

# ── Stripe (billing) ───────────────────────────────────
STRIPE_SECRET_KEY=sk_live_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
# STRIPE_SECRET_KEY_FILE=/run/secrets/stripe_secret_key
# STRIPE_WEBHOOK_SECRET_FILE=/run/secrets/stripe_webhook_secret
STRIPE_PRICE_BASIC=price_CHANGE_ME
STRIPE_PRICE_PRO=price_CHANGE_ME
STRIPE_PRICE_ENTERPRISE=price_CHANGE_ME
BILLING_PORTAL_RETURN_URL=https://app.vetmanager.io/billing

# ── MercadoPago ────────────────────────────────────────
MP_ACCESS_TOKEN=CHANGE_ME
MP_PUBLIC_KEY=CHANGE_ME

# ── Email ──────────────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=CHANGE_ME
# SMTP_PASS_FILE=/run/secrets/smtp_pass
FROM_EMAIL=noreply@vetmanager.io

# ── hCaptcha ───────────────────────────────────────────
HCAPTCHA_SECRET=CHANGE_ME
HCAPTCHA_SITE_KEY=CHANGE_ME
VITE_HCAPTCHA_SITE_KEY=CHANGE_ME

# ── Storage (MinIO / S3) ───────────────────────────────
MINIO_ENDPOINT=s3.amazonaws.com
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
# MINIO_ACCESS_KEY_FILE=/run/secrets/minio_access_key
# MINIO_SECRET_KEY_FILE=/run/secrets/minio_secret_key
MINIO_BUCKET=vetmanager-prod

# ── Feature flags defaults ─────────────────────────────
CAPTCHA_ENABLED=true
VITE_CAPTCHA_ENABLED=true
DEVICE_FINGERPRINT_ENABLED=true
DLP_EXPORT_THRESHOLD=1000
DLP_EXPORT_WINDOW_SECS=300

# ── DLP ────────────────────────────────────────────────
DLP_EXPORT_THRESHOLD=1000
DLP_EXPORT_WINDOW_SECS=300

# ── Slow query log ─────────────────────────────────────
SLOW_QUERY_MS=500

# ── Circuit breaker ────────────────────────────────────
CIRCUIT_THRESHOLD=5
CIRCUIT_TIMEOUT_MS=30000
CIRCUIT_SUCCESS=2

# ── AWS (opcional, para Secrets Manager) ──────────────
# AWS_REGION=us-east-1
# AWS_SECRET_ID=vetmanager/prod/secrets
TRACING_ENABLED=true
TRACING_EXPORTER_URL=http://tempo:9411/api/v2/spans
METRICS_TOKEN=CHANGE_ME_METRICS_TOKEN
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
# METRICS_TOKEN_FILE=/run/secrets/metrics_token
# GRAFANA_PASSWORD_FILE=/run/secrets/grafana_password
# SECRETS_FILE=/run/secrets/app-secrets.json
SERVICE_DISCOVERY_MODE=hybrid
EVENT_BUS_OUTBOX=true
EVENT_BUS_OUTBOX_RELAY_INTERVAL_MS=5000
EVENT_BUS_OUTBOX_MAX_ATTEMPTS=10
