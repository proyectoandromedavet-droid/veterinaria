# ─── Database ───────────────────────────────────────────────
# NEVER commit real credentials — use a secrets manager in production
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=vetmanager
MYSQL_USER=YOUR_DB_USER
MYSQL_PASSWORD=YOUR_DB_PASSWORD
MYSQL_ROOT_PASSWORD=YOUR_DB_ROOT_PASSWORD
MYSQL_POOL_MIN=2
MYSQL_POOL_MAX=20

# ─── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://shuttle.proxy.rlwy.net:41836
# Alternativa interna Railway:
# REDIS_URL=redis://redis.railway.internal:6379?family=0
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USER=
REDIS_TTL_REFRESH=604800       # 7 días (segundos)

# ─── JWT (RS256 asimétrico — generar con: openssl genrsa -out private.pem 2048) ─
# En producción se requieren JWT_PRIVATE_KEY y JWT_PUBLIC_KEY
# Para desarrollo se generan claves efímeras automáticamente
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
# JWT_PRIVATE_KEY=<base64 del PEM privado>
# JWT_PUBLIC_KEY=<base64 del PEM público>

# ─── Secreto interno (service-to-service HMAC) ──────────────
# Generar con: node -e "require('crypto').randomBytes(64).toString('hex')|console.log"
INTERNAL_SECRET=YOUR_INTERNAL_SECRET_64_BYTES_HEX

# ─── API Gateway ────────────────────────────────────────────
PORT=4050
NODE_ENV=development
API_VERSION=v1
ALLOWED_ORIGINS=http://localhost:4200

# ─── Rate Limiting ──────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000     # 1 minuto
RATE_LIMIT_MAX=100             # requests por ventana por IP
RATE_LIMIT_AUTH_MAX=10         # requests de login por ventana por IP

# ─── Archivos / MinIO ───────────────────────────────────────
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_USER=YOUR_MINIO_USER
MINIO_PASSWORD=YOUR_MINIO_PASSWORD
MINIO_BUCKET_PATIENTS=patient-files
MINIO_BUCKET_GROOMING=grooming-photos
MINIO_BUCKET_TELE=tele-docs
MAX_FILE_SIZE_MB=20

# ─── Servicios internos ─────────────────────────────────────
SERVICE_AUTH=http://localhost:4051
SERVICE_PATIENTS=http://localhost:4052
SERVICE_MEDICAL=http://localhost:4053
SERVICE_LAB=http://localhost:4054
SERVICE_BILLING=http://localhost:4055
SERVICE_TELEMEDICINE=http://localhost:4056
SERVICE_GROOMING=http://localhost:4057
SERVICE_REPORTS=http://localhost:4058
SERVICE_NOTIFICATIONS=http://localhost:4059

# ─── WebSockets ─────────────────────────────────────────────
WS_HEARTBEAT_INTERVAL=30000

# ─── Logs ───────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json
